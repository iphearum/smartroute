# Database: sqlite, mysql, or PostgreSQL (pgsql/postgres/postgresql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Use 3306 for MySQL or 5432 for PostgreSQL
DB_PORT=5432
DB_DATABASE=smartroute
DB_USERNAME=postgres
DB_PASSWORD=123

# Map loading
SMARTROUTE_MAP_REGION=cambodia/phnom_penh
# SMARTROUTE_GRAPH=maps/cambodia/phnom_penh/base/phnom_penh.graphml
# SMARTROUTE_CUSTOM_GRAPHS=path/to/overlay.graphml,path/to/another.graphml

# Public Overpass servers are best-effort services. Downloads automatically
# retry and rotate through this comma-separated list when one is unavailable.
OVERPASS_ENDPOINTS=https://overpass-api.de/api,https://overpass.private.coffee/api,https://maps.mail.ru/osm/tools/overpass/api
OVERPASS_MAX_RETRIES=5
OVERPASS_RETRY_BACKOFF=3
OVERPASS_TIMEOUT=180
# A process-wide randomized delay is applied even when --workers is greater than 1.
OVERPASS_DELAY_MIN=1.0
OVERPASS_DELAY_MAX=3.0

# Application server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false

# Localize imported/upserted place names and addresses for the map's country.
TRANSLATION_ENABLED=true
TRANSLATION_CONCURRENCY=2
TRANSLATION_MAX_RETRIES=3
# deep-translator rejects payloads above 5000 characters.
TRANSLATION_CHUNK_CHARS=4500
